# ===== Database (Supabase) =====
# Pooled connection - for app runtime
DATABASE_URL_POOLED=postgresql://postgres.xxx:[password]@aws-0-region.pooler.supabase.com:6543/postgres
# Direct connection - for Prisma migrations
DATABASE_URL=postgresql://postgres.xxx:[password]@aws-0-region.pooler.supabase.com:5432/postgres

# ===== NextAuth =====
# Generate via: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ===== Google OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ===== App config =====
ALLOWED_EMAIL=

# ===== Strava (добавится в Milestone 5) =====
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=
# 32 bytes — generate via: openssl rand -hex 32
ENCRYPTION_KEY=

# ===== Cron =====
# Bearer token required by /api/cron/* — generate via: openssl rand -hex 32
CRON_SECRET=

# ===== Optional: Supabase services beyond DB =====
# Uncomment if using Supabase Storage / Realtime / etc.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ===== Optional: Monitoring =====
# SENTRY_DSN=